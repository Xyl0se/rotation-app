{
  "name": "rotation-app",
  "private": true,
  "version": "0.50.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:domain && npm run build:client && npm run build:server",
    "build:domain": "npm --prefix packages/rotation-domain run build",
    "build:client": "tsc -b && vite build",
    "build:server": "npm --prefix server run build",
    "lint": "npm run lint:frontend && npm run lint:server && npm run lint:domain",
    "lint:frontend": "eslint src vite.config.ts vitest.config.ts",
    "lint:server": "npm --prefix server run lint",
    "lint:domain": "npm --prefix packages/rotation-domain run lint",
    "preview": "vite preview",
    "test": "npm run test:domain && npm run test:frontend && npm run test:server",
    "test:domain": "npm --prefix packages/rotation-domain test",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test:server": "npm --prefix server test",
    "test:watch": "vitest --config vitest.config.ts",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "validate": "npm run lint && npm test && npm run docs:check && npm run build"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
